// Copy to Local.xcconfig and fill in. Needed to run on a real device; the simulator works without it.
// Your team ID is in Xcode → Settings → Accounts, or at developer.apple.com under Membership.
DEVELOPMENT_TEAM = ABCDE12345
// Any ID you own, in reverse-domain form. It has to be unique across the App Store.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.keepintouch
